SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only: required for durable quotas. Never put in public/ or commit it.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
REQUIRE_AUTH=1
COOKIE_SECURE=1
# Enable only after the incremental RPC migration is verified in a test project.
READER_RPC_V2=0
# Optional route-only JSON metrics on stderr; no URLs, cookies or book content.
READER_LOG_REQUESTS=0